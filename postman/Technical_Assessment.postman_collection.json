		{
			"name": "2. Order Service - Middle Level Core Features",
			"item": [
				{
					"name": "[IoC Strategy] Create Order - PERCENTAGE_TEN (10% Discount)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 1,\n    \"discountType\": \"PERCENTAGE_TEN\",\n    \"items\": [\n        {\n            \"productName\": \"Mechanical Keyboard RGB\",\n            \"quantity\": 1,\n            \"price\": 100.00\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders"
							]
						},
						"description": "Menunjukkan Spring IoC Strategy Pattern. Memvalidasi userId 1 ke user-service, memilih PercentageDiscountStrategy (diskon 10% = $10.00, total $90.00), dan menerbitkan OrderCreatedEvent."
					},
					"response": []
				},
				{
					"name": "[IoC Strategy] Create Order - BULK_PURCHASE (Quantity >= 3)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 1,\n    \"discountType\": \"BULK_PURCHASE\",\n    \"items\": [\n        {\n            \"productName\": \"Desk Mat Premium\",\n            \"quantity\": 3,\n            \"price\": 20.00\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders"
							]
						},
						"description": "Menguji BulkPurchaseDiscountStrategy. Total quantity = 3 (memenuhi syarat >= 3 item), diskon 15% diterapkan."
					},
					"response": []
				},
				{
					"name": "[IoC Strategy] Create Order - VIP_TIER (20% Discount)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 2,\n    \"discountType\": \"VIP_TIER\",\n    \"items\": [\n        {\n            \"productName\": \"4K Monitor Ultra-wide\",\n            \"quantity\": 1,\n            \"price\": 300.00\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders"
							]
						},
						"description": "Menguji VipUserDiscountStrategy. Menghitung diskon 20% ($60.00) dari subtotal $300.00."
					},
					"response": []
				},
				{
					"name": "[IoC Strategy Fallback] Create Order - NONE (No Discount)",
