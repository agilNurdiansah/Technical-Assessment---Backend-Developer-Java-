						"body": {
							"mode": "raw",
							"raw": "{\n    \"userId\": 9999,\n    \"discountType\": \"NONE\",\n    \"items\": [\n        {\n            \"productName\": \"USB Cable\",\n            \"quantity\": 1,\n            \"price\": 10.00\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders"
							]
