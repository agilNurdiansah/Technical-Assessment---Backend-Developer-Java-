						"description": "Menguji validasi inter-service: order-service memanggil user-service untuk userId 9999. User tidak ditemukan, server merespons 400 Bad Request."
					},
					"response": []
				},
				{
					"name": "[Java Stream API] Order Analytics Summary",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders/analytics/summary",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"analytics",
								"summary"
							]
						},
						"description": "Menampilkan analitik menggunakan operasi Java Stream API: groupingBy (status & revenue), partitioningBy (high-value >= $50 vs standard), summarizingDouble (stats), reduce (total volume), dan flatMap (product leaderboard)."
					},
					"response": []
				},
				{
					"name": "[Native SQL CTE + DENSE_RANK] User Spending Rankings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders/reports/user-rankings",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"reports",
								"user-rankings"
							]
						},
						"description": "Menjalankan intermediate native SQL query dengan Common Table Expression (WITH UserOrderStats AS (...)) dan Window Function DENSE_RANK() OVER (ORDER BY total_spent DESC)."
					},
					"response": []
				},
				{
					"name": "[Native SQL Window Functions] Cumulative Spent Progression",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders/reports/cumulative-spent",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"reports",
								"cumulative-spent"
							]
						},
						"description": "Menjalankan intermediate native SQL query dengan Window Functions ROW_NUMBER() OVER (PARTITION BY user_id) dan running total SUM() OVER (PARTITION BY user_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)."
					},
					"response": []
				},
				{
					"name": "[Native SQL JOIN + HAVING] Product Sales Performance",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl_order}}/api/v1/orders/reports/product-performance?minQuantity=1",
							"host": [
								"{{baseUrl_order}}"
							],
							"path": [
								"api",
								"v1",
								"orders",
								"reports",
								"product-performance"
							],
							"query": [
								{
									"key": "minQuantity",
									"value": "1"
								}
							]
						},
						"description": "Menjalankan intermediate native SQL query dengan Multi-table INNER JOIN antara orders dan order_items, agregasi volume penjualan, dan HAVING clause filter."
					},
					"response": []
				}
			]
		},
